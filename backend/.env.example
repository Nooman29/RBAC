# Copy to .env (local run) or .env.docker (Docker Compose) and fill in real values.
# For Docker, the host in DATABASE_URL must be "db" and the password must match POSTGRES_PASSWORD in the root .env.
DATABASE_URL=postgresql://rbac_user:change-me@localhost:5432/rbac_db
SECRET_KEY=generate-with-python-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

BIOMETRIC_MODEL=Facenet512
BIOMETRIC_DETECTOR=retinaface
BIOMETRIC_DISTANCE_THRESHOLD=0.30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
OTP_EXPIRY_SECONDS=300

PENDING_TOKEN_EXPIRE_SECONDS=300

FRONTEND_URL=http://127.0.0.1:5173
