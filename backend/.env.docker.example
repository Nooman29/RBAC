# Copy to backend/.env.docker (never commit it).

# Host "db" is the compose service. User, password and database must match the root .env.
DATABASE_URL=postgresql://rbac_user:CHANGE_ME@db:5432/rbac_db

# Long random string. Generate with: openssl rand -hex 32
# Changing it later logs everyone out and invalidates service-client secrets.
SECRET_KEY=CHANGE_ME

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email is required: it carries OTP codes, account setup links and alert notices.
# For Gmail use an App Password (Google account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=CHANGE_ME

# The URL users open in the browser (used in email links and CORS).
# Local: http://127.0.0.1:5173   Live: https://your-domain
FRONTEND_URL=http://127.0.0.1:5173

# Optional: frontends of other modules that call this API from the browser, comma-separated.
# CORS_EXTRA_ORIGINS=http://localhost:3000,https://attendance.example.com