# Copy to .env (never commit .env).

# --- Database (used by docker-compose) ---
POSTGRES_USER=rbac_user
# Letters and numbers only (it is embedded in DATABASE_URL). Example: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=rbac_db

# --- Live deployment only (docker-compose.prod.yml) ---
# Public domain pointing at your server, e.g. rbac.example.com
DOMAIN=rbac.example.com
# Makes plain `docker compose ...` use the production file on the server.
COMPOSE_FILE=docker-compose.prod.yml